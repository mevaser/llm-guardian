# Copy this file to .env for local development only.
# Do not commit real secrets.

LLM_GUARDIAN_MODE=offline
LLM_GUARDIAN_ATTACK_LIBRARY=data/attack_library.yaml
LLM_GUARDIAN_REPORT_DIR=reports

# Optional future providers. Leave empty unless explicitly using them.
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Planner provider: groq or gemini
LLM_GUARDIAN_PLANNER_PROVIDER=gemini

# Gemini planner provider
GEMINI_API_KEY=
LLM_GUARDIAN_GEMINI_MODEL=gemini-3.1-flash-lite

# Planner behavior
LLM_GUARDIAN_PLANNER_TEMPERATURE=0
LLM_GUARDIAN_PLANNER_MAX_TOKENS=900
LLM_GUARDIAN_PLANNER_HISTORY_WINDOW=all
LLM_GUARDIAN_PLANNER_STRUCTURED_OUTPUT=true
